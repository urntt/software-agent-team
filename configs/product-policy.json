{
  "schema_version": 1,
  "id": "product_python_v1",
  "authority": "product",
  "sandbox": {
    "backend": "docker",
    "image": "sat-python-quality:phase1-v6",
    "pull": "never",
    "network": "none",
    "read_only_root_filesystem": true,
    "workspace_access": "read_only",
    "workspace_target": "/workspace",
    "tmpfs_target": "/tmp",
    "user": "host",
    "environment": {
      "HOME": "/tmp/home",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONPYCACHEPREFIX": "/tmp/pycache",
      "PYTHONUNBUFFERED": "1",
      "RUFF_CACHE_DIR": "/tmp/ruff-cache",
      "TMPDIR": "/tmp",
      "XDG_CACHE_HOME": "/tmp/cache"
    }
  },
  "limits": {
    "command_timeout_seconds": 120,
    "total_timeout_seconds": 420,
    "cpu_cores": 1.0,
    "memory_mb": 512,
    "pids": 128,
    "open_files": 1024,
    "writable_tmpfs_mb": 128,
    "stdout_max_bytes": 1048576,
    "stderr_max_bytes": 1048576
  }
}
