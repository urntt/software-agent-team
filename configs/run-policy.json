{
  "schema_version": 1,
  "id": "phase1_deterministic",
  "agent_budget": {
    "schema_version": 1,
    "max_calls": 14,
    "max_input_tokens": 1000000,
    "max_output_tokens": 200000,
    "max_agent_duration_seconds": 7200,
    "max_estimated_cost_usd": "25.00"
  },
  "agent_stage_timeouts_seconds": {
    "clarifier": 120,
    "single_agent": 900,
    "planner": 120,
    "generalist_developer": 900,
    "frontend_developer": 900,
    "backend_developer": 900,
    "integrator": 900,
    "tester": 300,
    "reviewer": 300
  },
  "sandbox": {
    "backend": "docker",
    "image": "sat-task-manager-quality:phase1-v1",
    "pull": "never",
    "network": "none",
    "read_only_root_filesystem": true,
    "workspace_access": "read_only",
    "workspace_target": "/workspace",
    "tmpfs_target": "/tmp",
    "user": "host",
    "environment": {
      "HOME": "/tmp/home",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONPYCACHEPREFIX": "/tmp/pycache",
      "PYTHONUNBUFFERED": "1",
      "RUFF_CACHE_DIR": "/tmp/ruff-cache",
      "TASK_MANAGER_DATABASE_PATH": "/tmp/project-tests.sqlite3",
      "TMPDIR": "/tmp",
      "XDG_CACHE_HOME": "/tmp/cache"
    }
  },
  "limits": {
    "command_timeout_seconds": 120,
    "total_timeout_seconds": 300,
    "cpu_cores": 1.0,
    "memory_mb": 512,
    "pids": 128,
    "open_files": 1024,
    "writable_tmpfs_mb": 128,
    "stdout_max_bytes": 1048576,
    "stderr_max_bytes": 1048576
  }
}
